{
    "name": "jigoku",
    "version": "2.0.0",
    "description": "The server code for Jigoku, a browser based implementation of the Legend of the Five Rings LCG",
    "type": "module",
    "main": "build/server/gamenode/index.js",
    "scripts": {
        "test": "npm run jasmine -- --parallel=auto",
        "jasmine": "tsc -p tsconfig.test.json --noCheck && JASMINE_CONFIG_PATH=./jasmine.json DOMAIN=localhost ENVIRONMENT=test GAME_NODE_NAME=test GAME_NODE_SOCKET_IO_PORT=9500 HTTPS=false LOBBY_PORT=4000 LOBBY_WS_URL=ws://localhost:6000 SECRET=testsecret jasmine",
        "lint": "eslint server/ test/",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jigoku/jigoku.git"
    },
    "keywords": [
        "l5r",
        "legend",
        "of",
        "the",
        "five",
        "rings",
        "cardgame"
    ],
    "author": "Ryan Karetas <ryan@karetas.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/jigoku/jigoku/issues"
    },
    "homepage": "https://github.com/jigoku/jigoku#readme",
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "jsonwebtoken": "9.0.3",
        "socket.io": "4.8.4",
        "winston": "3.19.0",
        "winston-daily-rotate-file": "5.0.0",
        "ws": "8.22.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/jasmine": "7.0.0",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "26.6.6",
        "@types/ws": "8.18.2",
        "eslint": "10.13.0",
        "eslint-plugin-jasmine": "4.2.2",
        "globals": "17.13.0",
        "jasmine": "7.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1"
    },
    "volta": {
        "node": "26.8.2"
    }
}
